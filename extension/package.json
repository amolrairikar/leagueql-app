    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@types/chrome": "^0.0.299",
    "@types/node": "25.9.9",
    "jsdom": "29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
