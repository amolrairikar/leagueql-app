// Deployed by Terraform (infrastructure/cloudflare) — do NOT `wrangler deploy`.
// This file is only used for local `wrangler dev` against a built frontend (frontend/dist).
// Bindings, the domain and the OTEL_EXPORTER_TOKEN secret are owned by Terraform.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leagueql-app",
  "compatibility_date": "2025-09-27",
  // Worker entry: serves static assets via the ASSETS binding and adds the
  // same-origin /ingest/traces → Better Stack proxy (frontend/observability). Static asset requests
  // are served directly; only non-asset routes (e.g. /ingest/traces) invoke the Worker.
  "main": "workers/leagueql-app/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Runtime vars for the /ingest/traces → Better Stack proxy (frontend/observability). The OTLP
  // traces URL is not sensitive, so it lives here; the source token is a Worker
  // *secret* (OTEL_EXPORTER_TOKEN) set by Terraform and never committed. Both must be set
  // for the proxy to forward (else 204).
  "vars": {
    "OTEL_TRACES_URL": "https://s2655032.eu-central-1a.betterstackdata.com/v1/traces"
  }
}
